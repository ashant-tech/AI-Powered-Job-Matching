# Copy to .env (repo root) and fill in real values before `docker compose up`.
# NEVER commit the filled-in .env — it contains secrets.

# JWT signing key (min 32 chars, e.g. `openssl rand -hex 32`)
SECRET_KEY=

# Postgres password used by the db service and both app DATABASE_URLs
POSTGRES_PASSWORD=

# Telegram bot token from @BotFather (required for push notifications)
TELEGRAM_BOT_TOKEN=

# Public site domain, used by Caddy for automatic HTTPS (docker-compose.https.yml)
DOMAIN=localhost

# CORS / frontend URLs — set to your real production domain, e.g.:
# CORS_ORIGINS=https://jobs.example.com
# FRONTEND_URL=https://jobs.example.com
# NEXT_PUBLIC_API_URL=https://jobs.example.com/api
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional
OPENAI_API_KEY=

# OCR for scanned/image CV PDFs (Tesseract).
# In Docker, tesseract-ocr is installed and on PATH, so leave TESSERACT_CMD empty.
# On a local Windows/macOS dev machine, point it at the installed binary, e.g.:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_ENABLED=true
TESSERACT_CMD=
OCR_DPI=300
